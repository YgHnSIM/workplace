{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yghnsim.github.io/workplace/schema/topics.schema.json",
  "title": "Topic registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["topics"],
  "properties": {
    "topics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "label": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
